{
  "name": "@tastic/shell",
  "version": "0.2.0",
  "description": "The app around a pack of React Native games, two-seat or for one player: Home, the loadout, the stats screen, Profiles and Settings, the pack's Redux store and its root providers, driven by one PackDefinition",
  "keywords": [
    "react-native",
    "expo",
    "expo-router",
    "local-multiplayer",
    "couch-multiplayer",
    "game-pack",
    "redux"
  ],
  "homepage": "https://github.com/jayrdeaton/react-native-game-shell#readme",
  "bugs": {
    "url": "https://github.com/jayrdeaton/react-native-game-shell/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jayrdeaton/react-native-game-shell.git"
  },
  "license": "MIT",
  "author": "Jay Deaton",
  "sideEffects": [
    "./src/navigation.ts",
    "./src/components/Theme.tsx",
    "./dist/*"
  ],
  "type": "commonjs",
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "browser": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "react-native": "src/index.ts",
  "types": "dist/index.d.ts",
  "files": [
    "assets",
    "dist",
    "src",
    "!src/__tests__",
    "!src/__mocks__",
    "!src/testUtils"
  ],
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "fix": "eslint --fix",
    "lint": "eslint",
    "prepublishOnly": "npm run build",
    "release": "git push --follow-tags",
    "release:major": "npm version major && npm run release",
    "release:minor": "npm version minor && npm run release",
    "release:patch": "npm version patch && npm run release",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm test && npm run typecheck && npm run build",
    "preversion": "npm run verify"
  },
  "prettier": "@infinitetoken/eslint-config/prettier",
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@expo/vector-icons": "^15.1.1",
    "@infinitetoken/eslint-config": "^0.2.1",
    "@infinitetoken/jest-config": "^0.5.2",
    "@infinitetoken/tsconfig": "^0.6.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@react-native/jest-preset": "^0.88.0",
    "@reduxjs/toolkit": "^2.13.0",
    "@rific/auto-paper": "^0.13.4",
    "@rific/core": "^0.5.0",
    "@rific/feedback-press": "^0.13.1",
    "@rific/focus-chain": "^0.4.8",
    "@rific/gestures": "^0.1.3",
    "@rific/splash-gate": "^0.2.3",
    "@rific/toaster": "^0.12.0",
    "@rific/updater": "^0.8.0",
    "@tastic/achievements": "^0.6.0",
    "@tastic/core": "^0.14.0",
    "@tastic/edge-guard": "^0.1.5",
    "@tastic/hud": "^0.26.0",
    "@tastic/profile": "^0.17.0",
    "@tastic/split-screen": "^0.5.5",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-native": "^5.0.0",
    "expo": "~58.0.19",
    "expo-audio": "~58.0.10",
    "expo-blur": "~58.0.5",
    "expo-constants": "~58.0.13",
    "expo-font": "~58.0.10",
    "expo-haptics": "~58.0.7",
    "expo-keep-awake": "~58.0.3",
    "expo-router": "~58.0.26",
    "expo-sensors": "~58.0.4",
    "expo-splash-screen": "~58.0.11",
    "expo-system-ui": "~58.0.6",
    "expo-updates": "~58.0.18",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.12",
    "prettier": "^3.8.3",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-paper": "^5.15.3",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-worklets": "0.13.0",
    "react-redux": "^9.3.0",
    "redux": "^5.0.1",
    "redux-persist": "^6.0.0",
    "test-renderer": "^1.3.1",
    "tsup": "^8.0.0",
    "typescript": "~6.0.3"
  },
  "peerDependencies": {
    "@expo/vector-icons": ">=15.1.1",
    "@react-native-async-storage/async-storage": ">=2.2.0",
    "@react-native-masked-view/masked-view": ">=0.3.2",
    "@reduxjs/toolkit": ">=2.13.0",
    "@rific/auto-paper": ">=0.13.4",
    "@rific/core": ">=0.5.0",
    "@rific/feedback-press": ">=0.13.1",
    "@rific/splash-gate": ">=0.2.3",
    "@rific/toaster": ">=0.10.1",
    "@tastic/achievements": ">=0.6.0",
    "@tastic/core": ">=0.14.0",
    "@tastic/edge-guard": ">=0.1.5",
    "@tastic/hud": ">=0.26.0",
    "@tastic/profile": ">=0.16.2",
    "@tastic/split-screen": ">=0.5.5",
    "expo-blur": ">=58.0.4",
    "expo-constants": ">=58.0.12",
    "expo-font": ">=58.0.8",
    "expo-haptics": ">=58.0.7",
    "expo-keep-awake": ">=58.0.3",
    "expo-router": ">=58.0.23",
    "expo-sensors": ">=58.0.4",
    "expo-splash-screen": ">=58.0.10",
    "react": ">=19.3.0",
    "react-native": ">=0.88.0",
    "react-native-gesture-handler": ">=3.3.0",
    "react-native-paper": ">=5.15.3",
    "react-native-reanimated": ">=4.7.1",
    "react-native-safe-area-context": ">=5.10.1",
    "react-redux": ">=9.3.0",
    "redux": ">=5.0.1",
    "redux-persist": ">=6.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
